# ====== AgroSyntra One - Backend Environment ======
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا ترفع .env إلى GitHub أبداً.

NODE_ENV=development
PORT=4000

# قاعدة البيانات (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=agrocloud
DB_PASSWORD=change_me
DB_DATABASE=agrocloud_vision
DB_SYNCHRONIZE=false

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ====== تكامل الطقس (Weather) — محرّك Open-Meteo مفتوح المصدر ======
# المستودع الرسمي: https://github.com/open-meteo/open-meteo
WEATHER_PROVIDER=open-meteo

# افتراضياً فارغ => تُستخدم الخدمة العامة المجانية (api.open-meteo.com) تلقائياً،
# بلا أي مفتاح API وتعمل فوراً دون أي إعداد إضافي.
#
# عندما تحدّد لاحقاً مسار إضافة الـ API الخاص بك (نسخة ذاتية الاستضافة self-hosted
# من نفس مستودع open-meteo/open-meteo أعلاه، عبر Docker على خادمك)، ضع عنوانها هنا
# وسيُعاد توجيه كل طلبات الطقس إليها تلقائياً دون أي تعديل في الكود:
#   OPEN_METEO_FORECAST_URL=http://localhost:8080/v1/forecast
#   OPEN_METEO_ARCHIVE_URL=http://localhost:8080/v1/archive
OPEN_METEO_FORECAST_URL=
OPEN_METEO_ARCHIVE_URL=

# مزود بديل مستقبلي (اختياري)
OPENWEATHER_API_KEY=

# ====== EOS Data Analytics (مفتاح موجود مسبقاً) ======
# يُستخدم لاحقاً في المرحلة 2 لتكامل الأقمار الصناعية (Sentinel-1/2, NDVI)
# ضع القيمة الحقيقية هنا محلياً فقط - لا تضعها في الكود ولا في GitHub
# احصل على المفتاح و الـ API ID من https://console.eos.com (API Dashboard)
EOS_API_KEY=
EOS_API_ID=
EOS_API_BASE_URL=https://api-connect.eos.com
