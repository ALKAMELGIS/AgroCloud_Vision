# ====== AgroCloud Vision — root quick-start environment reference ======
# This file is a summary only. Copy the real values into:
#   backend/.env            (copy from backend/.env.example)
#   frontend/.env.local     (copy from frontend/.env.local.example)
# Never commit .env or .env.local — they are already in .gitignore.

# ---------- Backend (backend/.env) ----------
NODE_ENV=development
PORT=4000

# PostgreSQL + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=agrocloud
DB_PASSWORD=change_me
DB_DATABASE=agrocloud_vision
DB_SYNCHRONIZE=true

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Weather — Open-Meteo (free, no key needed; leave blank to use the public API)
WEATHER_PROVIDER=open-meteo
OPEN_METEO_FORECAST_URL=
OPEN_METEO_ARCHIVE_URL=
OPENWEATHER_API_KEY=

# EOS Data Analytics — satellite/NDVI integration (Phase 2)
# Get your API key & ID at https://console.eos.com (API Dashboard)
EOS_API_KEY=
EOS_API_ID=
EOS_API_BASE_URL=https://api-connect.eos.com

# ---------- Frontend (frontend/.env.local) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
